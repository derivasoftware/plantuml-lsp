@startuml CL_Symbols
' requirement REQ-00002-1

!startsub SymbolsModule
!includesub ./CL_Parsing.puml!ParsingModule

namespace plantuml_lsp.symbols {
  class collect_symbols <<function>> {
    + collect_symbols(src: bytes) : list[SymbolTuple]
  }
  class _entry <<function>> {
    - _entry(name: str, kind: str, node: Node) : SymbolTuple
  }
  class _name_of <<function>> {
    - _name_of(node: Node, src: bytes) : str
  }
  class _walk <<function>> {
    - _walk(node: Node, src: bytes, ns: list[str], found: list[SymbolTuple]) : None
  }
}

_name_of ..> node_text
_walk ..> node_text
collect_symbols ..> parse
!endsub

@enduml
