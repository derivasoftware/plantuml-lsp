    + build_index(doc_path: str, src: bytes) : Index
  }
  class identifier_at <<function>> {
    + identifier_at(src: bytes, row: int, col: int) : str | None
  }
  class _add <<function>> {
    - _add(index: Index, node: Node, src: bytes, path: str, kind: str) : None
  }
  class _declared_kind <<function>> {
    - _declared_kind(node: Node, src: bytes) : str | None
  }
  class _index_file <<function>> {
    - _index_file(path: str, src: bytes, index: Index, seen: set[str]) : None
  }
  class _members <<function>> {
    - _members(node: Node, src: bytes) : list[str]
  }
  class _methods <<function>> {
    - _methods(node: Node, src: bytes) : dict[str, tuple[int, int, int, str]]
  }
  class _record_relation <<function>> {
    - _record_relation(node: Node, src: bytes, index: Index) : None
  }
  class _register_call <<function>> {
    - _register_call(index: Index, path: str, node: Node, name: str, offset: int) : None
  }
