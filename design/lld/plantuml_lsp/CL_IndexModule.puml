  class _visit_action <<function>> {
    - _visit_action(node: Node, src: bytes, path: str, index: Index, lane: list) : None
  }
  class _visit_relation <<function>> {
    - _visit_relation(node: Node, src: bytes, path: str, index: Index) : None
  }
  class _visit_swimlane <<function>> {
    - _visit_swimlane(node: Node, src: bytes, lane: list) : None
  }
  class _walk <<function>> {
    - _walk(node: Node, src: bytes, path: str, index: Index, lane: list) : None
  }
  class resolve_entity <<function>> {
    + resolve_entity(name: str, entities: dict[str, "Entity"]) : str | None
  }
  class word_at <<function>> {
    + word_at(src: bytes, row: int, col: int) : str | None
  }
}

!endsub

@enduml
