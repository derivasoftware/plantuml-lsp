@startuml CL_Server
' requirement REQ-00001-1
' requirement REQ-00002-1
' requirement REQ-00003-1
' requirement REQ-00004-1

!startsub ServerModule

namespace plantuml_lsp.server {
  class did_open <<function>> {
    + did_open(ls: LanguageServer, params: DidOpenTextDocumentParams) : None
  }
  class did_change <<function>> {
    + did_change(ls: LanguageServer, params: DidChangeTextDocumentParams) : None
  }
  class document_symbol <<function>> {
    + document_symbol(ls: LanguageServer, params: DocumentSymbolParams)
  }
  class definition <<function>> {
    + definition(ls: LanguageServer, params: DefinitionParams)
  }
  class formatting <<function>> {
    + formatting(ls: LanguageServer, params: DocumentFormattingParams)
  }
  class main <<function>> {
    + main() : None
  }
}

!endsub

@enduml
