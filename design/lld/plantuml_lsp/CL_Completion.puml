@startuml CL_Completion
' requirement REQ-00006-1
' requirement REQ-00013-1

!startsub CompletionModule

namespace plantuml_lsp.completion {
  class collect_completions <<function>> {
    + collect_completions(index: Index) : list[CompletionTuple]
  }
  class contextual_completions <<function>> {
    + contextual_completions(src: bytes, row: int, col: int, index: Index, workspace: WorkspaceIndex | None) : list[ContextualTuple]
  }
  class _action_completions <<function>> {
    - _action_completions(src: bytes, row: int, index: Index, workspace: WorkspaceIndex | None) : list[ContextualTuple]
  }
  class _active_lane <<function>> {
    - _active_lane(src: bytes, row: int) : str | None
  }
  class _after_operator <<function>> {
    - _after_operator(prefix: str) : bool
  }
  class _endpoint_completions <<function>> {
    - _endpoint_completions(index: Index, workspace: WorkspaceIndex | None) : list[ContextualTuple]
  }
  class _head_completions <<function>> {
    - _head_completions(index: Index) : list[ContextualTuple]
  }
  class _label_completions <<function>> {
    - _label_completions(prefix: str, index: Index, workspace: WorkspaceIndex | None) : list[ContextualTuple]
  }
  class _message_receiver <<function>> {
    - _message_receiver(head: str) : str | None
  }
  class _participant_completions <<function>> {
    - _participant_completions(workspace: WorkspaceIndex) : list[ContextualTuple]
  }
  class _receiver_methods <<function>> {
    - _receiver_methods(receiver: str, index: Index, workspace: WorkspaceIndex | None) : list[ContextualTuple]
  }
}

!endsub

@enduml
