@startuml CL_Actions
' requirement REQ-00014-1

!startsub ActionsModule
!includesub ./CL_Parsing.puml!ParsingModule
!includesub ./index/CL_Entity.puml!Entity

namespace plantuml_lsp.actions {
  class declare_entity <<function>> {
    + declare_entity(name: str, doc_path: str, src: bytes) : FixTuple | None
  }
  class fix_include_path <<function>> {
    + fix_include_path(row: int, line: str, doc_path: str, workspace: WorkspaceIndex) : FixTuple | None
  }
  class declare_method <<function>> {
    + declare_method(method: str, entity: Entity, workspace: WorkspaceIndex) : FixTuple | None
  }
  class _body_of_declaration_at <<function>> {
    - _body_of_declaration_at(root, src: bytes, entity: Entity)
  }
}

!endsub

@enduml
